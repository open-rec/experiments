{
  "dataset": "ebnerd",
  "data": "data/processed/ebnerd-small-context.parquet",
  "openrec_algorithm": "../rec-algorithm",
  "model": "lightgbm",
  "seed": 42,
  "threads": 8,
  "content_features": true,
  "context_features": true,
  "interaction_features": true,
  "relative_temporal_features": true,
  "long_term_user_features": true,
  "topic_entity_affinity_features": true,
  "article_metadata": "data/raw/ebnerd_small/articles.parquet",
  "candidate_statistical_rank_features": true,
  "session_exposure_features": true,
  "past_candidate_exposure_features": true,
  "past_candidate_exposure_extended_features": true,
  "fixed_history_features": true,
  "history_files": [
    "data/raw/ebnerd_small/train/history.parquet",
    "data/raw/ebnerd_small/validation/history.parquet"
  ],
  "train_start": "2023-05-18T07:00:00Z",
  "validation_start": "2023-05-22T07:00:00Z",
  "test_start": "2023-05-25T07:00:00Z",
  "test_end": "2023-06-01T07:00:00Z",
  "update_interval_ms": 86400000,
  "feedback_delay_ms": 3600000,
  "evaluation_feedback": "frozen",
  "lightgbm": {
    "n_estimators": 500,
    "learning_rate": 0.05,
    "num_leaves": 63,
    "min_child_samples": 100,
    "subsample": 0.9,
    "colsample_bytree": 0.9,
    "reg_lambda": 1.0
  }
}
