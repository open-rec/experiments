{
  "dataset": "kuairand-1k",
  "data": "data/processed/kuairand-1k.parquet",
  "openrec_algorithm": "../rec-algorithm",
  "model": "lightgbm",
  "seed": 42,
  "epochs": 10,
  "batch_size": 4096,
  "learning_rate": 0.001,
  "factor_dim": 8,
  "threads": 8,
  "train_start": "2022-04-07T14:00:00Z",
  "validation_start": "2022-04-18T16:00:00Z",
  "test_start": "2022-04-21T16:00:00Z",
  "test_end": "2022-05-08T16:00:00Z",
  "update_interval_ms": 86400000,
  "feedback_delay_ms": 3600000,
  "evaluation_feedback": "frozen",
  "feature_selection": {
    "user": [
      "user.event_count",
      "user.event_active_days",
      "user.event_unique_scene_count",
      "user.event_unique_item_count",
      "user.event_first_time",
      "user.event_last_time",
      "user.event_recency_seconds",
      "user.event_count_1d",
      "user.event_count_7d",
      "user.event_count_30d",
      "user.event_click_count",
      "user.event_expose_count",
      "user.event_click_rate",
      "user.event_expose_count_5m",
      "user.event_expose_count_1h",
      "user.event_expose_count_24h"
    ],
    "candidate": [
      "item.scene",
      "item.event_count",
      "item.event_active_days",
      "item.event_unique_scene_count",
      "item.event_unique_user_count",
      "item.event_first_time",
      "item.event_last_time",
      "item.event_recency_seconds",
      "item.event_count_1d",
      "item.event_count_7d",
      "item.event_count_30d",
      "item.event_click_count",
      "item.event_expose_count",
      "item.event_click_rate",
      "item.event_expose_count_5m",
      "item.event_expose_count_1h",
      "item.event_expose_count_24h"
    ]
  },
  "lightgbm": {
    "n_estimators": 500,
    "learning_rate": 0.05,
    "num_leaves": 63,
    "min_child_samples": 100,
    "subsample": 0.9,
    "colsample_bytree": 0.9,
    "reg_lambda": 1.0
  }
}
