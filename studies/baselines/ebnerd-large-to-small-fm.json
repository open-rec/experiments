{
  "dataset": "ebnerd",
  "data": "data/processed/ebnerd-large-to-small.parquet",
  "openrec_algorithm": "../rec-algorithm",
  "model": "fm",
  "seed": 42,
  "epochs": 5,
  "batch_size": 16384,
  "learning_rate": 0.001,
  "factor_dim": 8,
  "threads": 16,
