  },
  "train_start": "2023-05-18T07:00:00Z",
  "validation_start": "2023-05-24T07:00:00Z",
  "test_start": "2023-05-25T07:00:00Z",
  "test_end": "2023-06-01T07:00:00Z",
  "update_interval_ms": 86400000,
  "feedback_delay_ms": 3600000,
  "evaluation_feedback": "frozen"
}
